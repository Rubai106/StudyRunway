# StudyRunway environment template
# Copy to .env.local for local development and set real values.

# Provider selection: AI_BACKEND takes precedence when set.
AI_PROVIDER=demo
AI_BACKEND=vertex-adc
AUTH_MODE=ADC

# Google OAuth sign-in for the StudyRunway website (separate from Vertex ADC).
# Create a Web application OAuth client; see docs/SETUP.md for callback URLs.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional when a reverse proxy does not forward the public host correctly.
# For Cloud Run, set this to https://YOUR-PUBLIC-HOST/api/auth.
AUTH_URL=

# Google Vertex AI (standard Google Cloud project; authenticates through ADC)
VERTEX_AI_PROJECT=YOUR_PROJECT_ID
VERTEX_AI_LOCATION=global
VERTEX_AI_MODEL=google/gemini-3.5-flash
# Native Gemini model used only by official-policy research with Google Search grounding.
VERTEX_AI_RESEARCH_MODEL=gemini-2.5-flash
# For local use, run `gcloud auth application-default login`.
# Or set GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON file path
# stored outside this repository.

# xAI
XAI_API_KEY=PLACEHOLDER
XAI_MODEL=PLACEHOLDER
XAI_BASE_URL=PLACEHOLDER

# Google AI Studio Gemini (separate from Vertex AI)
GEMINI_API_KEY=PLACEHOLDER
GEMINI_MODEL=PLACEHOLDER
GEMINI_BASE_URL=PLACEHOLDER

# OpenAI
OPENAI_API_KEY=PLACEHOLDER
OPENAI_MODEL=PLACEHOLDER
OPENAI_BASE_URL=PLACEHOLDER

# Anthropic
ANTHROPIC_API_KEY=PLACEHOLDER
ANTHROPIC_MODEL=PLACEHOLDER

# Test/runtime toggles
LIVE_API=0
PW_REUSE_SERVER=0

# Session persistence
# Local development uses memory. Production should use Firestore with the
# Cloud Run service identity granted roles/datastore.user on this project.
STUDYRUNWAY_SESSION_STORE=memory
STUDYRUNWAY_DEMO_MODE=true
FIRESTORE_PROJECT_ID=

# Audit storage: local stdout by default; set cloud-logging on Google Cloud.
# The runtime identity then needs roles/logging.logWriter in the target project.
STUDYRUNWAY_AUDIT_STORE=stdout

# Wise Platform display-only quote preview (no transfers are created).
# Disabled until Wise Platform access/terms are confirmed for this deployment.
WISE_QUOTES_ENABLED=false
# production returns indicative current quotes; sandbox returns non-live test quotes.
WISE_QUOTES_ENV=production
